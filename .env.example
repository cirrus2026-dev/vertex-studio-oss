# Vertex AI Cloud Studio - Configuration
# ตั้งค่า Google Cloud Vertex AI (ทางเลือกที่ 1)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Google AI Studio API Key (ทางเลือกที่ 2)
# รับฟรีได้ที่ https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# พอร์ตทำงาน
PORT=5005
BRIDGE_PORT=8765
